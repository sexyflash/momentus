{
  "name": "momentus-link-redirect",
  "main": "index.js",
  "compatibility_date": "2026-07-13",
  // /l/* 만 잡는다. 이 패턴이 the-moment.us/* 보다 구체적이라 apex 워커보다 먼저 매칭된다.
  // apex(정적자산 + _redirects)는 절대 건드리지 않는다.
  "routes": [
    { "pattern": "the-moment.us/l/*", "zone_name": "the-moment.us" }
  ],
  "observability": { "enabled": true }
}
